# Windows/MSYS2 paths to the toolchain recovered from the user's RR build kit.
CC=./toolchain/codewarrior/mwcceppc.exe
AS=./toolchain/codewarrior/mwasmeppc.exe
KAMEK=./toolchain/kamek/Kamek.exe
# Override MKNITRO_AC_MODE=1 only after the manifest's runtime review.
MKNITRO_AC_MODE ?= 0
CFLAGS += -DMKNITRO_SERVER -DMKNITRO_AC_ENFORCE_INTEGRITY=$(MKNITRO_AC_MODE)
